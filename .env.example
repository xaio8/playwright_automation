# --- AI provider selection -------------------------------------------------
# Registered ids: openrouter | openai | ollama | mock
AI_PROVIDER=openrouter
# Overrides the provider's default model
AI_MODEL=
# Optional base-url override (per provider: <PROVIDER>_BASE_URL wins)
AI_BASE_URL=

# Key lookup is <PROVIDER_ID>_API_KEY, so a new provider needs no code changes
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# --- Browser exploration ---------------------------------------------------
# Allow targeting localhost/private IPs (development only: disables SSRF guard)
ALLOW_PRIVATE_TARGETS=false

# --- Test execution --------------------------------------------------------
# Env vars generated plans may read through {{VAR}} placeholders
TEST_VARS_ALLOWLIST=
