{
  "name": "ai-playwright-tester",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @ai-tester/web dev",
    "dev:api": "pnpm --filter @ai-tester/api dev",
    "dev:worker": "pnpm --filter @ai-tester/worker dev",
    "lint": "eslint . && pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
